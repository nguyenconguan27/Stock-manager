2025-12-29 00:13:15.957 [JavaFX Application Thread] INFO  c.m.s.m.d.i.ExportReceiptDetailDaoImpl - UPDATE DB.EXPORT_RECEIPT_DETAIL 
SET DB.EXPORT_RECEIPT_DETAIL.EXPORT_PRICE_ID = ?,  
    DB.EXPORT_RECEIPT_DETAIL.ORIGINAL_UNIT_PRICE = ?
WHERE DB.EXPORT_RECEIPT_DETAIL.id IN (
    SELECT DB.EXPORT_RECEIPT_DETAIL.id 
    FROM DB.EXPORT_PRICE
    JOIN DB.EXPORT_RECEIPT_DETAIL 
        ON DB.EXPORT_RECEIPT_DETAIL.EXPORT_PRICE_ID = DB.EXPORT_PRICE.id
    JOIN DB.EXPORT_RECEIPT 
        ON DB.EXPORT_RECEIPT.id = DB.EXPORT_RECEIPT_DETAIL.EXPORT_RECEIPT_ID
    JOIN DB.PRODUCT 
        ON DB.PRODUCT.id = DB.EXPORT_RECEIPT_DETAIL.PRODUCT_ID 
    WHERE DB.EXPORT_PRICE.EXPORT_TIME = ? 
        AND DB.PRODUCT.id = ?
        AND CAST(PARSEDATETIME(DB.EXPORT_RECEIPT.CREATE_AT, 'dd/MM/yyyy HH:mm:ss') AS TIMESTAMP)
            >= CAST(PARSEDATETIME(?, 'dd/MM/yyyy HH:mm:ss') AS TIMESTAMP)
        AND (
            CAST(PARSEDATETIME(DB.EXPORT_RECEIPT.CREATE_AT, 'dd/MM/yyyy HH:mm:ss') AS TIMESTAMP)
                < CAST(PARSEDATETIME(?, 'dd/MM/yyyy HH:mm:ss') AS TIMESTAMP)
            OR ? IS NULL
        )
);

